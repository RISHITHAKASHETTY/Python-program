    "class Student:\n",
    "    def __init__ (self,marks):\n",
    "        self.marks=marks\n",
    "\n",
    "    def __add__ (self,other):\n",
    "        return self.marks+other.marks\n",
    "\n",
    "s1=Student(80)\n",
    "s2=Student(75)\n",
    "print(s1+s2)"
